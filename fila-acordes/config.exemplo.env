# Copie este arquivo para "config.env" (o instalar.bat faz isso) e preencha.
# NUNCA envie o config.env para ninguém nem para o GitHub: a chave abaixo
# dá acesso total ao banco do Acervo.

SUPABASE_URL=https://uotxnchfvrgpxwimmefd.supabase.co

# Supabase > Project Settings > API Keys > aba "Legacy API Keys" > service_role (Reveal)
SUPABASE_SERVICE_ROLE_KEY=COLE_AQUI_A_CHAVE_SERVICE_ROLE

# De quantos em quantos segundos olhar a fila
INTERVALO_SEGUNDOS=10

# auto = lv-chordia (melhor) | dsp = motor leve, menos preciso
MOTOR=auto

# Nome deste computador (aparece só no banco)
NOME_COMPUTADOR=principal
